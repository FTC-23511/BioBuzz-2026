<Robot type="FirstInspires-FTC">
    <!-- Config for the 2026-27 REV DUO starter bot: mecanum drive, 1 motor ground
         intake, 1 CR servo feeder, 2 motor flywheel launcher. -->
<!--    <EthernetDevice name="limelight" serialNumber="EthernetOverUsb:eth0:172.29.0.31" port="0" ipAddress="172.29.0.1" />-->

    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <goBILDA5202SeriesMotor name="FL" port="0"/>
            <goBILDA5202SeriesMotor name="BL" port="1"/>
            <goBILDA5202SeriesMotor name="BR" port="2"/>
            <goBILDA5202SeriesMotor name="FR" port="3"/>

<!--            <goBILDAPinpoint name="pinpoint" port="0" bus="1"/>-->
            <OctoQuadFWv3 name="octoquad" port="0" bus="1"/>
        </LynxModule>
    </LynxUsbDevice>

    <LynxUsbDevice name="Expansion Hub Portal 1" serialNumber="DQ2F3UGC" parentModuleAddress="2">
        <LynxModule name="Expansion Hub 2" port="2">
            <!-- Both launch motors drive the same flywheel shaft, so leftLaunchMotor is
                 inverted in Robot.init(). The launcher velocity loop reads the encoder
                 plugged into the leftLaunchMotor port. -->
            <goBILDA5202SeriesMotor name="rightLaunchMotor" port="0"/>
            <goBILDA5202SeriesMotor name="leftLaunchMotor" port="1"/>
            <goBILDA5202SeriesMotor name="intakeMotor" port="2"/>

<!--            <AnalogInput name="turretEncoder" port="3"/>-->

            <!-- Axon Max+ in continuous rotation mode, driving the feeder roller. -->
            <ContinuousRotationServo name="transferServo" port="0"/>

            <!-- Not on the starter bot; kept commented for when the hood/ramp go on.
            <Servo name="hoodServo" port="3"/>
            <Servo name="rampServo" port="5"/>
            -->
        </LynxModule>
    </LynxUsbDevice>

    <!--TODO: Update webcam serial number with the color arducam one-->
    <Webcam name="Webcam 1" serialNumber="UC762" />
</Robot>
